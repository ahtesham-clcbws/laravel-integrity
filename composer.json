{
    "name": "clcbws/laravel-integrity",
    "description": "High-Fidelity Static AST & Container Reflection Integrity Suite for Laravel & Livewire.",
    "license": "MIT",
    "authors": [
        {
            "name": "CLC Broadway Web Services",
            "email": "services@broadwaywebservices.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Clcbws\\LaravelIntegrity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Clcbws\\LaravelIntegrity\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Clcbws\\LaravelIntegrity\\IntegrityServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}